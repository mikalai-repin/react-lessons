{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    // Типы проверок шагов (content/**/check.ts): import type { CheckContext } from '@course/check'
    "paths": { "@course/check": ["./src/check/types.ts"] }
  },
  "include": ["src", "vite.config.ts", "content/**/check.ts"]
}
