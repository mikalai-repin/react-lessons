{
  "name": "react-course-ru",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "predev": "npm run vendor",
    "dev": "vite",
    "prebuild": "VENDOR_MINIFY=1 npm run vendor",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "validate": "node scripts/validate-content.mjs && tsc -p .content-check/tsconfig.json",
    "step": "node scripts/step-files.mjs",
    "covers": "node scripts/build-covers.mjs",
    "e2e:dir": "node tools/e2e/run-dir.mjs",
    "e2e:chapter": "node tools/e2e/run-chapter.mjs",
    "chapter": "node scripts/chapter.mjs"
  },
  "dependencies": {
    "@shikijs/monaco": "4.5.0",
    "es-module-lexer": "3.0.3",
    "markdown-it": "15.0.2",
    "markdown-it-container": "4.0.0",
    "monaco-editor": "0.57.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.2",
    "react-router": "8.4.0",
    "shiki": "4.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.1",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-container": "4.0.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "puppeteer-core": "24.43.1",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "zustand": "5.0.15"
  }
}
